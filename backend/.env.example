# Reference only: ASP.NET Core does not automatically load this file.
# Export these variables in your local shell. See docs/public-development.md.
# Leave OPENAI_API_KEY empty for offline tests; readiness then reports unavailable.
# GPT-Live is the sole production engine. Realtime and legacy dialog/voice flags are retired.
OPENAI_API_KEY=
# Optional server-only OTLP tracing. No key belongs in mobile/browser/firmware.
Backend__Telemetry__Enabled=false
# Test: 1.0; production defaults to 0.1 when SampleRatio is omitted.
Backend__Telemetry__SampleRatio=1.0
Backend__Telemetry__Environment=development
# Independent opt-in for safe structured/application log metadata; production defaults Warning.
Backend__Telemetry__Logs__Enabled=false
Backend__Telemetry__Logs__MinimumLevel=Information
OTEL_SERVICE_NAME=dildovander-backend
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Default endpoint is a local collector. Select Honeycomb region before changing it.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://127.0.0.1:4318/v1/logs
# Configure ingestion headers privately; never put a real key here.
OTEL_EXPORTER_OTLP_HEADERS=
Backend__DatabasePath=REPLACE_WITH_ABSOLUTE_PATH_OUTSIDE_REPOSITORY/journal.sqlite
Backend__Memory__Enabled=true
Backend__Memory__CloudIndexingEnabled=false
Backend__Memory__LongTermPersonalEnabled=true
# Optional local identity. Replace with the SHA-256 of a random private credential.
# This placeholder is deliberately unusable; never use a fixed example credential.
Devices__0__DeviceId=local-development-device
Devices__0__CredentialSha256=REPLACE_WITH_SHA256_OF_RANDOM_PRIVATE_CREDENTIAL

# DV01 is mandatory; voice configuration is private and read once at process start.
Backend__GptLive__Character__HostTone=Adult
Backend__GptLive__Character__FinaleProfile=Blocked
Backend__GptLive__Voice__FallbackVoice=vesper
# Set either CustomVoiceId or an absolute, private provisioning JSON path.
Backend__GptLive__Voice__CustomVoiceId=
Backend__GptLive__Voice__ConfigurationPath=

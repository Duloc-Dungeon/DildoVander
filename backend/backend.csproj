<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <IncludeHardwareSimulator Condition="'$(IncludeHardwareSimulator)' == ''">false</IncludeHardwareSimulator>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BackendTests" />
    <PackageReference Include="Google.Apis.Auth" Version="1.73.0" />
    <EmbeddedResource Include="Features/SealedCase/Content/*.json" />
    <EmbeddedResource Include="Features/SealedCase/Content/*.md" />
    <EmbeddedResource Include="Features/SealedCase/sealed-case-content-version.json" LogicalName="Kufr.Backend.SealedCaseContentVersion" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" PrivateAssets="all" />
    <EmbeddedResource Include="../ai-eval/voice-persona.txt" LogicalName="Kufr.Backend.VoicePersona" />
    <EmbeddedResource Include="../ai-eval/ollivander-trunk-persona.txt" LogicalName="Kufr.Backend.OllivanderPersona" />
    <EmbeddedResource Include="../ai-eval/ollivander-trunk-live-persona.txt" LogicalName="Kufr.Backend.OllivanderLivePersona" />
    <EmbeddedResource Include="../ai-eval/prompt.txt" LogicalName="Kufr.Backend.PartyPrompt" />
    <EmbeddedResource Include="../ai-eval/wand-catalog.json" LogicalName="Kufr.Backend.PartyWandCatalog" />
    <EmbeddedResource Include="../ai-eval/wand-identities.json" LogicalName="Kufr.Backend.PartyWandIdentities" />
    <EmbeddedResource Include="../design-system/fonts/inter.ttf" LogicalName="Kufr.Backend.KeepsakeInter" />
    <Content Include="../design-system/fonts/inter-OFL.txt" Link="third-party-notices/inter-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="third-party-notices/SkiaSharp-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.20.1-beta.1" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageReference Include="WebPush" Version="1.0.13" />
  </ItemGroup>

  <!-- Paused hardware tooling is opt-in; product builds need no C++ compiler. -->
  <ItemGroup Condition="'$(IncludeHardwareSimulator)' == 'true' and $([MSBuild]::IsOSPlatform('Linux'))">
    <TestingTwinSource Include="../firmware/simulator/native/*.cpp;../firmware/simulator/native/*.h;../firmware/src/features/**/*.cpp;../firmware/src/features/**/*.h;../firmware/simulator/native/build_host.py" />
    <Content Include="$(IntermediateOutputPath)testing-native/kufr-native-twin" Link="testing-native/kufr-native-twin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildTestingHardwareTwin" BeforeTargets="BeforeBuild" Condition="'$(IncludeHardwareSimulator)' == 'true' and $([MSBuild]::IsOSPlatform('Linux'))"
          Inputs="@(TestingTwinSource)" Outputs="$(IntermediateOutputPath)testing-native/kufr-native-twin">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../firmware/simulator/native/build_host.py&quot; --output &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)testing-native/kufr-native-twin&quot;" />
  </Target>
</Project>

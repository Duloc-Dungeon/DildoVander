{
  "openapi": "3.1.0",
  "info": {
    "title": "Wand Night Stand sealed case rewards API",
    "version": "1.1.0",
    "description": "Read-only, account-scoped summaries for the authenticated participant's released sealed cases. No private case actions or other participant data are included."
  },
  "paths": {
    "/app/v1/sealed-cases/rewards": {
      "get": {
        "summary": "Read personal released case rewards",
        "x-source": "Features/SealedCase/SealedCaseRewards.cs",
        "parameters": [{
          "name": "scenarioMetadata",
          "in": "query",
          "required": false,
          "description": "Opt in to all scenario variants and their saved public title and the participant's own team label. Without this option only original last-bell cases are returned, with the original exact item shape, so older clients cannot mislabel other scenarios.",
          "schema": { "type": "boolean", "default": false }
        }],
        "security": [{ "AccountSession": [] }],
        "responses": {
          "200": {
            "description": "Released cases for which the current account is a rostered participant. With scenarioMetadata=true every item also contains scenario; without it the legacy item shape is preserved.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SealedCaseRewardCollection" }
              }
            }
          },
          "401": { "description": "Session unavailable" },
          "403": { "description": "Inactive or ineligible launch group" },
          "429": { "description": "Account rate limit reached" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AccountSession": { "type": "apiKey", "in": "cookie", "name": "dv-account" }
    },
    "schemas": {
      "SealedCaseRewardCollection": {
        "type": "object",
        "required": ["schemaVersion", "items"],
        "properties": {
          "schemaVersion": { "const": 1 },
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": { "$ref": "#/components/schemas/SealedCaseReward" }
          }
        },
        "additionalProperties": false
      },
      "SealedCaseReward": {
        "type": "object",
        "required": ["caseId", "releasedAt", "team", "confirmedPlans", "successfulPlans"],
        "properties": {
          "caseId": { "type": "string", "pattern": "^sc_[0-9a-f]{32}$" },
          "releasedAt": { "type": "string", "format": "date-time" },
          "team": { "type": "string", "enum": ["Guardian", "Conspirator"] },
          "confirmedPlans": { "type": "integer", "minimum": 0 },
          "successfulPlans": { "type": "integer", "minimum": 0 },
          "scenario": { "$ref": "#/components/schemas/SealedCaseRewardScenario" }
        },
        "additionalProperties": false
      },
      "SealedCaseRewardScenario": {
        "type": "object",
        "description": "Only saved public scenario identity and the authenticated participant's own team label. No assignments, evidence recipes, private actions or narrator prompts.",
        "required": ["id", "title", "teamLabel"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9_]{1,128}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "teamLabel": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "additionalProperties": false
      }
    }
  }
}

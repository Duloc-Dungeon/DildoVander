# Reference only: ASP.NET Core does not automatically load this file.
# Export these variables in your local shell. See docs/public-development.md.
# Leave OPENAI_API_KEY empty for offline tests; readiness then reports unavailable.
# Only Live and Realtime are production conversation engines. Legacy dialog/voice flags are retired.
# Server-only opt-in OpenTelemetry. Keep ingestion keys outside source control.
# Backend__Telemetry__Enabled=true
# Backend__Telemetry__SampleRatio=1.0
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://api.honeycomb.io/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=PRIVATE_INGEST_KEY
OPENAI_API_KEY=
Backend__DatabasePath=REPLACE_WITH_ABSOLUTE_PATH_OUTSIDE_REPOSITORY/journal.sqlite
Backend__Memory__Enabled=true
Backend__Memory__CloudIndexingEnabled=false
Backend__Memory__LongTermPersonalEnabled=true
# Optional local identity. Replace with the SHA-256 of a random private credential.
# This placeholder is deliberately unusable; never use a fixed example credential.
Devices__0__DeviceId=local-development-device
Devices__0__CredentialSha256=REPLACE_WITH_SHA256_OF_RANDOM_PRIVATE_CREDENTIAL
